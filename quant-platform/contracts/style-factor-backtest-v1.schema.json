{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio_backtester.style_factor_backtest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "signal",
    "n_quantiles",
    "observations",
    "cumulative_return",
    "returns"
  ],
  "properties": {
    "artifact_type": {"const": "portfolio_backtester.style_factor_backtest"},
    "schema_version": {"const": 1},
    "signal": {"type": "string", "minLength": 1},
    "n_quantiles": {"type": "integer", "minimum": 2},
    "observations": {"type": "integer", "minimum": 0},
    "cumulative_return": {"type": "number"},
    "returns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period_end",
          "long_return",
          "short_return",
          "long_short_return"
        ],
        "properties": {
          "period_end": {"type": "string", "format": "date"},
          "long_return": {"type": "number"},
          "short_return": {"type": "number"},
          "long_short_return": {"type": "number"}
        }
      }
    }
  }
}
