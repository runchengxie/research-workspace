{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.v1",
  "title": "research claim v1",
  "description": "机器可检查的投资判断对象。判断是策略决策线索的一等对象，回答我们究竟在相信什么、凭什么相信、看到什么以后必须停止相信。",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "statement",
    "claim_type",
    "status",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": {
      "const": "claim.v1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "hypothesis",
        "fact",
        "estimate",
        "inference"
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "critical_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observable",
          "threshold",
          "horizon"
        ],
        "properties": {
          "observable": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "abstain_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "reason"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "active",
        "proposed",
        "superseded",
        "rejected"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "additionalProperties": false
}