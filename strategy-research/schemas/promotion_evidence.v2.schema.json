{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy_promotion_evidence.v2",
  "title": "Canonical strategy promotion evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "profile_id",
    "review_id",
    "generated_at",
    "status",
    "research_window",
    "lineage",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy_promotion_evidence.v2"
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "pending",
        "diagnostic",
        "superseded"
      ]
    },
    "research_window": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "configured_start_date",
        "end_date"
      ],
      "properties": {
        "configured_start_date": {
          "$ref": "#/$defs/dateToken"
        },
        "end_date": {
          "$ref": "#/$defs/dateToken"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_repository",
        "repositories",
        "config",
        "current_contract",
        "data_manifests",
        "source_artifacts"
      ],
      "properties": {
        "producer_repository": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/gitSha"
          }
        },
        "config": {
          "$ref": "#/$defs/pathHash"
        },
        "current_contract": {
          "$ref": "#/$defs/pathHash"
        },
        "data_manifests": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/pathHash"
              },
              {
                "type": "object",
                "required": [
                  "asset_key"
                ],
                "properties": {
                  "asset_key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/pathHash"
              },
              {
                "type": "object",
                "required": [
                  "location"
                ],
                "properties": {
                  "location": {
                    "enum": [
                      "workspace",
                      "data_platform"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "pending",
              "diagnostic",
              "superseded"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "dateToken": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathHash": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
