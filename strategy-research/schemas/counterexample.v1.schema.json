{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counterexample.v1",
  "title": "research counterexample v1",
  "description": "反例驱动稳健性记录。它引用已有 claim 和证据，描述在哪类压力条件下研究判断明显变弱或失效；计算逻辑仍由数据、alpha、组合或策略应用 owner 维护。",
  "type": "object",
  "required": [
    "schema_version",
    "counterexample_id",
    "claim_id",
    "scenario_type",
    "summary",
    "as_of",
    "status",
    "severity",
    "stress_dimensions",
    "baseline_metrics",
    "stressed_metrics",
    "failure_conditions",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "counterexample.v1"},
    "counterexample_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "scenario_type": {
      "enum": [
        "time_window",
        "market_regime",
        "cost",
        "liquidity",
        "capacity",
        "exposure",
        "signal_perturbation",
        "correlation",
        "custom"
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": ["open", "confirmed", "resolved", "superseded"]
    },
    "severity": {
      "enum": ["minor", "material", "critical"]
    },
    "stress_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "baseline", "stressed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "baseline": {"type": ["string", "number", "boolean", "null"]},
          "stressed": {"type": ["string", "number", "boolean", "null"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "baseline_metrics": {"$ref": "#/$defs/metrics"},
    "stressed_metrics": {"$ref": "#/$defs/metrics"},
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
