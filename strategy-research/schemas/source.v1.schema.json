{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.v1",
  "title": "research source v1",
  "description": "DG3 定性来源溯源。为外部研究素材记录来源、事实属性与多维可信度，四个时间点分开记录，不合成单一来源等级。",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_type",
    "publisher",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "const": "source.v1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "effective_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "observed_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ingested_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "fact",
        "estimate",
        "guidance",
        "opinion",
        "inference",
        "forecast"
      ]
    },
    "directness": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "tertiary"
      ]
    },
    "verifiability": {
      "type": "string",
      "enum": [
        "independently_verified",
        "single_source",
        "unverifiable"
      ]
    },
    "independence": {
      "type": "string",
      "minLength": 1,
      "description": "DG3 来源独立性维度：来源是否独立于被支撑的判断，避免同一来源自我印证。"
    },
    "temporal_validity": {
      "type": "string",
      "minLength": 1,
      "description": "DG3 时间有效性维度：来源在当前论证时点是否仍有效。"
    },
    "fact_or_inference": {
      "type": "string",
      "minLength": 1,
      "description": "DG3 事实与推演属性维度：区分硬编码事实与推导结论，禁止把推演伪装成事实。"
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "entity_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
