{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_case.v1",
  "title": "research case v1",
  "description": "研究案例决策记录。case.json 只做导航，把研究问题、实验、证据、判断、评审与决策串成完整线索。",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "question",
    "as_of",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "research_case.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "research_specs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "evidence_bundles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "kind",
          "status"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "logic",
              "evidence"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "in_progress",
              "pending"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "reason"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "thesis"
      ],
      "description": "决策记录。DG6 要求把证据完备度（evidence_readiness 各维度）与投资信念（investment_conviction）分开表达，禁止合成单一置信度总分（如 overall_confidence / composite_score）。",
      "properties": {
        "status": {
          "enum": [
            "no_view",
            "provisional",
            "accepted",
            "rejected"
          ]
        },
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "evidence_readiness": {
          "type": "array",
          "description": "DG6 证据完备度卡片：按维度分别记录证据覆盖、来源可靠性、稳健性、未解决矛盾与时效性，不合成总分。",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "status"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "investment_conviction": {
          "type": "string",
          "minLength": 1,
          "description": "DG6 投资信念：主观、不可量化、不计入 evidence_readiness 总分，仅作决策者的判断附注。"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}