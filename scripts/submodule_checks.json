        "test": [["uv", "run", "--locked", "--extra", "dev", "python", "-m", "pytest"]],
        "type": [["uv", "run", "--locked", "--extra", "dev", "ty", "check"]],
        "release_typecheck": [["uv", "run", "--locked", "--extra", "dev", "ty", "check"]],
        "full": ["@lint", "@smoke", "@type", "@test"]
      }
    },
    "strategy-pipeline": {
      "path": "strategy-pipeline",
      "profiles": {
        "smoke": [
          ["uv", "run", "--locked", "--extra", "dev", "strategy", "--help"]
