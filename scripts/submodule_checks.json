          ["uv", "run", "--locked", "--extra", "dev", "ruff", "check", "."],
          ["uv", "run", "--locked", "--extra", "dev", "ruff", "format", "--check", "."],
          ["scripts/dev/run_tests.sh", "maintainability"]
        ],
        "test": [
          ["uv", "run", "--locked", "--extra", "dev", "python", "-m", "pytest"]
        ],
        "type": [
          ["uv", "run", "--locked", "--extra", "dev", "ty", "check"]
        ],
        "release_typecheck": [
          ["scripts/dev/run_tests.sh", "typecheck-release"]
        ],
        "full": ["@lint", "@smoke", "@type", "@test"]
      }
    },
    "deep-learning-tick-data-prediction": {
      "path": "deep-learning-tick-data-prediction",
      "profiles": {
        "smoke": [["uv", "run", "--locked", "--extra", "dev", "python", "-c", "import ticknet.eventstream; import ticknet.research.prediction_contract"]],
