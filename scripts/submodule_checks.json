          ["uv", "run", "--locked", "--group", "dev", "ruff", "check", "."],
          ["uv", "run", "--locked", "--group", "dev", "ruff", "format", "--check", "."],
          ["uv", "run", "--locked", "--group", "dev", "python", "scripts/dev/maintainability_metrics.py", "--ratchet"]
